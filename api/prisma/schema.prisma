generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN // platform operator, no BusinessMember rows needed
  OWNER // shop-side user, access is granted via BusinessMember
}

enum MemberRole {
  OWNER
  STAFF
}

enum TicketSource {
  REMOTE
  WALK_IN
}

enum TicketStatus {
  WAITING
  CALLED
  SERVING
  DONE
  SKIPPED
  NO_SHOW
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String?
  role               UserRole @default(OWNER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships BusinessMember[]

  @@map("users")
}

model BusinessMember {
  userId     String
  businessId String
  role       MemberRole @default(OWNER)
  createdAt  DateTime   @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, businessId])
  @@index([businessId])
  @@map("business_members")
}

model Business {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  category  String
  openTime  String
  closeTime String
  timezone  String   @default("Asia/Manila")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       BusinessMember[]
  services      Service[]
  queueTickets  QueueTicket[]
  queueCounters QueueCounter[]
  appointments  Appointment[]

  @@map("businesses")
}

model Service {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  durationMin   Int
  priceCentavos Int
  isActive      Boolean  @default(true) // soft-delete (tickets/appointments use Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  queueTickets QueueTicket[]
  appointments Appointment[]

  @@index([businessId])
  @@map("services")
}

model QueueTicket {
  id           String       @id @default(cuid())
  businessId   String
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  number       Int
  displayCode  String
  customerName String
  phone        String?
  token        String       @unique @default(uuid())
  source       TicketSource @default(WALK_IN)
  status       TicketStatus @default(WAITING)
  queueDate    String
  createdAt    DateTime     @default(now())
  calledAt     DateTime?
  servedAt     DateTime?
  completedAt  DateTime?

  @@unique([businessId, queueDate, number])
  @@index([businessId, queueDate, status])
  @@map("queue_tickets")
}

model QueueCounter {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  queueDate  String
  lastNumber Int      @default(0)

  @@id([businessId, queueDate])
  @@map("queue_counters")
}

model Appointment {
  id           String            @id @default(cuid())
  businessId   String
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customerName String
  phone        String?
  token        String            @unique @default(uuid())
  startsAt     DateTime
  endsAt       DateTime
  status       AppointmentStatus @default(CONFIRMED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([businessId, startsAt])
  @@index([businessId, status])
  @@map("appointments")
}
